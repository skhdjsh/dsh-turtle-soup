{
  "name": "dsh-turtle-soup",
  "version": "1.14.0",
  "private": true,
  "type": "module",
  "description": "海龟汤题库与主持人工具：内置 100 道题，抽题点单、局内控制、计分段位、社区评分、投稿码与 Issue 审核",
  "license": "MIT",
  "author": "zexuan604",
  "keywords": [
    "dsh",
    "plugin",
    "turtle-soup",
    "海龟汤",
    "puzzle",
    "game",
    "scoring"
  ],
  "homepage": "https://github.com/skhdjsh/dsh-turtle-soup",
  "repository": {
    "type": "git",
    "url": "https://github.com/skhdjsh/dsh-turtle-soup.git"
  },
  "engines": {
    "dsh": ">=0.2.2-rc.3"
  },
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "bank-seed.json",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "assets",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}